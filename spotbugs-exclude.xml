<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Excluir DTOs y modelos — son POJOs sin lógica -->
    <Match>
        <Package name="~com\.escuelaing\.techcup\.(dto|model).*"/>
    </Match>

    <!-- Excluir clase principal -->
    <Match>
        <Class name="com.escuelaing.techcup.App"/>
    </Match>

    <!-- Excluir falsos positivos de Spring Security (null checks en UserDetails) -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~com\.escuelaing\.techcup\.security\..*"/>
    </Match>

</FindBugsFilter>
